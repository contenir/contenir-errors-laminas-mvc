{
  "name": "contenir/errors-laminas-mvc",
  "description": "Laminas MVC adapter for contenir/errors — swaps the default error rendering with admin-authored per-status pages.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
    "contenir/errors": "^0.1 || ^2.0",
    "laminas/laminas-eventmanager": "^3.11",
    "laminas/laminas-http": "^2.19",
    "laminas/laminas-mvc": "^3.8",
    "laminas/laminas-servicemanager": "^3.22",
    "laminas/laminas-view": "^2.32",
    "psr/container": "^1.1 || ^2.0",
    "psr/log": "^1.0 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "infection/infection": "^0.34.1",
    "php-db/phpdb-qa-tools": "0.1.x-dev",
    "phpunit/phpunit": "^11.5.42"
  },
  "autoload": {
    "psr-4": {
      "Contenir\\Errors\\Laminas\\Mvc\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Contenir\\Errors\\Laminas\\Mvc\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "check": [
      "@cs-check",
      "@static-analysis",
      "@test",
      "@test-integration",
      "@mutation-test"
    ],
    "cs-check": [
      "mago format --check",
      "mago lint"
    ],
    "cs-fix": [
      "mago format",
      "mago lint --fix"
    ],
    "static-analysis": "mago analyze",
    "test": "phpunit --colors=always --testsuite unit",
    "test-integration": "phpunit --colors=always --testsuite integration",
    "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
    "mutation-test": "infection"
  },
  "config": {
    "platform": {
      "php": "8.3.99"
    },
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": true
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "2.0.x-dev"
    },
    "laminas": {
      "module": "Contenir\\Errors\\Laminas\\Mvc"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
